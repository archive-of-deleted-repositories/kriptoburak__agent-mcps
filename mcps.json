{
  "$schema": "./mcps.schema.json",
  "_comment": "Canonical MCP server registry for the Oriz fleet. Edit this file; scripts/sync-mcp-to-agents.mjs in the umbrella fans it to CC / OpenCode / Kilo / Antigravity / Copilot. Per rules: mcp-config-single-source-of-truth, canonical-repo-pure-data-orchestrator-in-umbrella, agent-fleet-parity.",
  "version": "1.0.0",
  "servers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "categories": ["web"],
      "agents": ["*"]
    },
    "searxng": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": { "SEARXNG_URL": "https://baresearch.org" },
      "categories": ["web", "search"],
      "agents": ["*"]
    },
    "open-websearch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "open-websearch"],
      "env": { "MODE": "stdio", "DEFAULT_SEARCH_ENGINE": "duckduckgo" },
      "categories": ["web", "search"],
      "agents": ["*"]
    },
    "mcp-crawl": {
      "type": "stdio",
      "command": "node",
      "args": ["./scripts/crawl-mcp/server.js"],
      "categories": ["web"],
      "agents": ["cc"],
      "_workspace_local": true
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "ide-assistant",
        "--project", "."
      ],
      "categories": ["coding", "codebase"],
      "agents": ["cc", "opencode", "kilo"]
    },
    "codebase-memory": {
      "type": "stdio",
      "command": "C:/Users/C5420321/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
      "args": [],
      "categories": ["coding", "memory"],
      "agents": ["cc"],
      "_windows_only": true
    },
    "one-search-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "one-search-mcp"],
      "env": { "SEARCH_PROVIDER": "local" },
      "categories": ["web", "search"],
      "agents": ["*"]
    },
    "resend": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "${env:RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "chirag@oriz.in"
      },
      "categories": ["email"],
      "agents": ["*"]
    },
    "screenpipe": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "screenpipe@latest", "mcp"],
      "env": { "SCREENPIPE_API_KEY": "${env:SCREENPIPE_API_KEY}" },
      "categories": ["memory", "personal"],
      "agents": ["cc"]
    },
    "morph-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "morph-mcp"],
      "env": { "MORPH_API_KEY": "${env:MORPH_API_KEY}" },
      "categories": ["fast-apply"],
      "agents": ["cc"]
    },
    "foam": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "foam-cli", "mcp", "--workspace", "${env:ORIZ_KNOWLEDGE_DIR}"],
      "env": { "ORIZ_KNOWLEDGE_DIR": "${env:ORIZ_KNOWLEDGE_DIR:-C:/D/oriz/knowledge}" },
      "categories": ["knowledge"],
      "agents": ["cc"]
    },
    "shrimp-task-manager": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-shrimp-task-manager"],
      "env": { "DATA_DIR": "${env:SHRIMP_DATA_DIR:-C:/D/oriz/.staging/shrimp-tasks}" },
      "categories": ["coding", "task-management"],
      "agents": ["cc", "opencode", "kilo", "antigravity"],
      "_added": "2026-07-04",
      "_source": "https://github.com/cjo4m06/mcp-shrimp-task-manager",
      "_purpose": "Persistent task memory + dependency management + self-reflection for coding agents. Layered redundancy with superpowers writing-plans + executing-plans."
    },
    "pandoc": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-pandoc"],
      "categories": ["docs", "conversion"],
      "agents": ["*"],
      "_added": "2026-07-04",
      "_source": "https://github.com/vivekvells/mcp-pandoc",
      "_purpose": "Universal doc format converter (MD/HTML/PDF/DOCX/CSV/ebook). Layered with markitdown."
    },
    "mermaid": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@narasimhaponnada/mermaid-mcp-server"],
      "categories": ["docs", "diagrams"],
      "agents": ["*"],
      "_added": "2026-07-04",
      "_source": "https://github.com/Narasimhaponnada/mermaid-mcp",
      "_purpose": "22+ Mermaid diagram types with SVG/PNG/PDF export. Layered with diagram-generator skill (Graphviz)."
    },
    "oxidize-pdf": {
      "type": "stdio",
      "command": "uvx",
      "args": ["oxidize-pdf"],
      "categories": ["docs", "pdf"],
      "agents": ["*"],
      "_added": "2026-07-04",
      "_source": "https://github.com/bzsanti/oxidize-python",
      "_purpose": "Rust-powered PDF toolkit — create/read/split/merge/rotate/encrypt PDFs. Text extraction for RAG."
    },
    "mcp-observatory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-observatory"],
      "categories": ["meta", "testing"],
      "agents": ["cc"],
      "_added": "2026-07-04",
      "_source": "https://github.com/KryptosAI/mcp-observatory",
      "_purpose": "Regression tests for MCP server configs. Detects tool-schema drift between versions."
    },
    "mcp-doctor": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-doctor"],
      "categories": ["meta", "diagnostics"],
      "agents": ["cc"],
      "_added": "2026-07-04",
      "_source": "https://github.com/realwigu/mcp-doctor",
      "_purpose": "Zero-config diagnostics — auto-discovers CC/Cursor/VSCode configs, tests JSON-RPC handshake, benchmarks latency."
    }
  },
  "_categories": {
    "web": "Web content fetching, scraping, crawling",
    "search": "Web search engines (SearXNG, Brave, Linkup, DDG, Google)",
    "coding": "Code intelligence, LSP, refactoring, testing",
    "codebase": "Repo-wide understanding, graph indexing",
    "memory": "Persistent memory, cross-session recall",
    "docs": "Documentation retrieval + conversion",
    "diagrams": "Diagram + chart generation",
    "pdf": "PDF-specific tooling",
    "email": "Email sending / reading",
    "personal": "Personal data (screenpipe, health, calendar)",
    "fast-apply": "Fast-apply / patch tools",
    "knowledge": "OKF / knowledge base / notes",
    "task-management": "Task tracking + dependency graphs",
    "meta": "MCP server operations (diagnostics, testing)",
    "testing": "Test harnesses + regression detection",
    "diagnostics": "Health checks, benchmarks, drift detection",
    "conversion": "Format conversion (doc formats, encodings)"
  },
  "_agent_targets": {
    "*": "All fleet agents (CC + OpenCode + Kilo + Antigravity + Copilot)",
    "cc": "Claude Code only",
    "opencode": "OpenCode only",
    "kilo": "Kilo Code only",
    "antigravity": "Antigravity only",
    "copilot": "GH Copilot CLI only"
  }
}
